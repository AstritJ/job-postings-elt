# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- PostgreSQL (data warehouse) ---
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs_local_pw
POSTGRES_DB=jobs_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Object storage (S3-compatible, SeaweedFS) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=local_access_key
S3_SECRET_KEY=local_secret_key
S3_REGION=us-east-1
S3_PORT=8333
S3_BUCKET_RAW=raw-job-postings
